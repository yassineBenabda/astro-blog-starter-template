---
const today = new Date();
---

<footer>
	<div class="footer-container">
		<div class="footer-info">
			<h3>Engineered for Precision.</h3>
			<p>Custom digital products, performant web applications, and technical consulting for growing businesses.</p>
		</div>
		<div class="footer-links">
			<div class="column">
				<h4>Navigation</h4>
				<a href="/">Home</a>
				<a href="/services">Services</a>
				<a href="/work">Case Studies</a>
				<a href="/blog">Insights</a>
			</div>
			<div class="column">
				<h4>Connect</h4>
				<a href="https://github.com" target="_blank" rel="noopener noreferrer">GitHub</a>
				<a href="https://linkedin.com" target="_blank" rel="noopener noreferrer">LinkedIn</a>
				<a href="https://twitter.com" target="_blank" rel="noopener noreferrer">Twitter/X</a>
			</div>
		</div>
	</div>
	<div class="bottom-bar">
		<p>&copy; {today.getFullYear()} Modern Web Agency. All rights reserved.</p>
		<p class="status"><span class="dot"></span> Systems Operational</p>
	</div>
</footer>

<style>
	footer {
		background: #0f172a;
		color: #f8fafc;
		padding: 4em 1.5em 2em 1.5em;
		margin-top: 5em;
	}
	.footer-container {
		max-width: 1100px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		gap: 3em;
		flex-wrap: wrap;
	}
	.footer-info {
		max-width: 350px;
	}
	.footer-info h3 {
		color: #ffffff;
		margin-top: 0;
	}
	.footer-info p {
		color: #94a3b8;
		font-size: 0.95rem;
		line-height: 1.5;
	}
	.footer-links {
		display: flex;
		gap: 4em;
	}
	.column {
		display: flex;
		flex-direction: column;
		gap: 0.5em;
	}
	.column h4 {
		font-size: 0.9rem;
		color: #ffffff;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 0.5em;
	}
	.column a {
		color: #94a3b8;
		text-decoration: none;
		font-size: 0.9rem;
		transition: color 0.2s ease;
	}
	.column a:hover {
		color: #38bdf8;
	}
	.bottom-bar {
		max-width: 1100px;
		margin: 4em auto 0 auto;
		padding-top: 2em;
		border-top: 1px solid #1e293b;
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 0.85rem;
		color: #64748b;
	}
	.status {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	.dot {
		width: 8px;
		height: 8px;
		background: #22c55e;
		border-radius: 50%;
	}
</style>