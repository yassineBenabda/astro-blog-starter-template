---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<div class="brand">
			<a href="/" class="logo-text">{SITE_TITLE}<span>.dev</span></a>
		</div>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/services">Services</HeaderLink>
			<HeaderLink href="/work">Work</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/blog">Insights</HeaderLink>
		</div>
		<div class="actions">
			<a href="/contact" class="btn-nav">Estimate Project</a>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1.5em;
		background: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid #e2e8f0;
		position: sticky;
		top: 0;
		z-index: 100;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		height: 70px;
	}
	.logo-text {
		font-weight: 700;
		font-size: 1.25rem;
		color: #0f172a;
		text-decoration: none;
	}
	.logo-text span {
		color: #0284c7;
	}
	.internal-links {
		display: flex;
		gap: 1.5em;
	}
	.internal-links a {
		padding: 0.5em 0;
		color: #475569;
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 500;
		transition: color 0.2s ease;
	}
	.internal-links a:hover,
	.internal-links a.active {
		color: #0f172a;
	}
	.btn-nav {
		padding: 0.5em 1em;
		background: #0f172a;
		color: #ffffff;
		border-radius: 6px;
		text-decoration: none;
		font-size: 0.875rem;
		font-weight: 600;
		transition: background 0.2s ease;
	}
	.btn-nav:hover {
		background: #1e293b;
	}
	@media (max-width: 720px) {
		.internal-links {
			display: none;
		}
	}
</style>